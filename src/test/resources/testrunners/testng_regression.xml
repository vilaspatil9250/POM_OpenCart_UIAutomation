<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="OpenCart app - Regression Suite" verbose="5" >

	<listeners>
		<listener class-name="com.qa.opencart.listeners.TestAllureListener" />
		<listener class-name="com.aventstack.chaintest.plugins.ChainTestListener" />
		<listener class-name="com.qa.opencart.listeners.AnnotationTransformer" />
	</listeners>

	<test name="Home Page Test Case">
	<parameter name="browser" value="chrome" />
		<classes>
			<class name="com.qa.opencart.tests.HomePageTest" />
		</classes>
	</test>

	<test name="Login page Test Case">
	<parameter name="browser" value="firefox" />
		<classes>
			<class name="com.qa.opencart.tests.LoginPageTest" />
		</classes>
	</test>

	<test name="My Account Page Test Case">
	<parameter name="browser" value="edge" />
		<classes>
			<class name="com.qa.opencart.tests.MyAccountTest" />
		</classes>
	</test>

	<test name="Product Info Page Test Case">
	<parameter name="browser" value="chrome" />
		<classes>
			<class name="com.qa.opencart.tests.ProductInfoPageTest" />
		</classes>
	</test>

	<test name="Search List Page Test Case">
	<parameter name="browser" value="firefox" />
		<classes>
			<class name="com.qa.opencart.tests.SearchListPageTest" />
		</classes>
	</test>

	<test name="Shopping Cart Page Test Case">
	<parameter name="browser" value="edge" />
		<classes>
			<class name="com.qa.opencart.tests.ShoppingCartPageTest" />
		</classes>
	</test>

	<test name="Registration Page Test Case">
	<parameter name="browser" value="chrome" />
		<classes>
			<class name="com.qa.opencart.tests.RegistrationPageTest" />
		</classes>
	</test>

</suite>